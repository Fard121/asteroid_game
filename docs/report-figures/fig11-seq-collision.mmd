sequenceDiagram
    autonumber
    participant G as Core::Game
    participant CD as Collision::CollisionDetector
    participant SL as Common::ServiceLocator
    participant AS as Asteroids::AsteroidSplitterImpl<br/>«IAsteroidSplitter»
    participant PS as Common::PlayerState
    participant SS as Common::ScoreState
    participant W as Common::World

    G->>CD: process(gameData, world)
    CD->>W: getEntities()
    W-->>CD: snapshot list
    loop each unordered pair, j after i
        CD->>CD: isValidCollision(cat1, cat2)?
        CD->>CD: collides(e1, e2) -- Pythagoras
        alt Player involved
            CD->>PS: isInvulnerable()?
            PS-->>CD: false
            CD->>PS: registerHit()
            CD->>CD: damage(other)
            Note over CD,PS: Player entity is never removed,<br/>PlayerControlSystem consumes the hit next frame
        else Enemy ship vs asteroid
            CD->>CD: enemy.damage(enemy.getHealth())
            Note over CD: Ship destroyed outright, no score credited
        else Bullet hit
            CD->>CD: damage(e1) and damage(e2)
            opt target destroyed
                CD->>SS: addPoints(20 / 50 / 100 / 200)
            end
        end
        opt destroyed entity is an ASTEROID
            CD->>SL: ServiceLoader.load(getLayer(), IAsteroidSplitter.class)
            SL-->>CD: splitter
            CD->>AS: createSplitAsteroid(asteroid, world)
            alt size has a smaller size
                AS->>W: addEntity(2 x smaller asteroid)
            else already SMALL
                Note over AS: Nothing added -- fully destroyed
            end
        end
    end
    CD->>W: removeEntity(e) for each queued removal
    Note over CD,W: Removal happens only after the full scan,<br/>so no pair is skipped or double-processed
